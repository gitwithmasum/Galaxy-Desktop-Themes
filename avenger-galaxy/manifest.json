{
  "manifest_version": 3,
  "name": "Masum Avenger Galaxy New Tab",
  "description": "Rotating galaxy New Tab, futuristic search console, results overlay, and live wallpaper.",
  "version": "1.3.0",
  "permissions": ["bookmarks", "tabGroups", "tabs"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com.bd/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "results-theme.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
